# Copy this file to .env.local for local dev (npm run dev).
# All values come from your Firebase project:
#   Firebase console -> Project settings (gear icon) -> "Your apps" -> Web app -> SDK config.
# These are safe to expose in a frontend; your data is protected by the
# Firestore security rules (see firestore.rules), which allow only your two emails.

VITE_FIREBASE_API_KEY=YOUR-API-KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR-PROJECT-ID
VITE_FIREBASE_APP_ID=YOUR-APP-ID
# Needed for document file uploads (Firebase Storage). Same SDK config block —
# usually "YOUR-PROJECT.appspot.com" or "YOUR-PROJECT.firebasestorage.app".
VITE_FIREBASE_STORAGE_BUCKET=YOUR-PROJECT.appspot.com

# NOTE: your Claude API key is NOT set here. You enter it inside the app
# (Settings -> AI document assistant); it is stored in your private database and
# must never be baked into the frontend build.
